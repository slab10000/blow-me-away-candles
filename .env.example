VITE_SUPABASE_URL=https://ekxeaqbbnnprllwarcpe.supabase.co
# Use the public anon key from Supabase Project Settings > API Keys.
VITE_SUPABASE_ANON_KEY=

# Server-only USPS credentials. Never prefix these with VITE_.
# Current setup: https://developers.usps.com/getting-started
# In https://cop.usps.com, go to My Apps > your app > Credentials.
# Consumer Key -> USPS_CLIENT_ID; Consumer Secret -> USPS_CLIENT_SECRET.
# The app needs Domestic Pricing access (OAuth scope: domestic-prices).
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Use production credentials for both hosts; test selects USPS TEM.
USPS_ENVIRONMENT=production
USPS_ORIGIN_ZIP=60622
# Gross packed weight/dimensions of ONE candle. One box per candle for now.
USPS_PACKAGE_WEIGHT_LB=4
USPS_PACKAGE_LENGTH_IN=12
USPS_PACKAGE_WIDTH_IN=12
USPS_PACKAGE_HEIGHT_IN=12

# Required for deployment; local dev can use an ephemeral signing key.
# Generate a persistent key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKOUT_SIGNING_SECRET=
# Deployment only: apply the checkout_orders migration and set this server secret.
# Local npm run dev/preview saves orders in .local-orders/ without this key.
SUPABASE_SERVICE_ROLE_KEY=
